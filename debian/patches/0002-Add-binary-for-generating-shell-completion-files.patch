+#[macro_use]
+extern crate clap;
+extern crate iron;
+extern crate libc;
+extern crate time;
+extern crate xml;
+
+mod ops;
+mod options;
+pub mod util;
+
+pub struct Error(pub String);
+pub use options::{Options, LogLevel};
+
+use clap::Shell;
+
+
+fn main() {
+    Options::with_app(|mut app|
+        for &shell in &[Shell::Bash, Shell::Zsh, Shell::Fish] {
+            for &bin in &["http", "httplz"] {
+                app.gen_completions(bin, shell, ".");
+            }
+        }
+    );
+}
